{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quelplan",
  "version": "0.1.0",
  "identifier": "com.bbb24.quelplan",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "quelplan",
        "width": 1152,
        "height": 720,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "resizable": false,
        "maximizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERjJBNkNCNDEwOERDMgpSV1RDalJDMGJDcmZENVZuOXc3MHcyYjkxYXc3bUkzNXZKeXhmL2tCcmlKMkRvSXJGVEU2cVFqNQo=",
      "endpoints": [
        "https://github.com/Rance-21/Quelplan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
